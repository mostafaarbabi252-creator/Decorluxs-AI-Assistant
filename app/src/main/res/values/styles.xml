<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorAccent">@color/gold</item>
    </style>

    <style name="LuxurySecondaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_dark</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="LuxuryPrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/button_gold</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
